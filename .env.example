# Copy to .env.local. Demo mode needs none of these; live sessions need CREATEAI_API_KEY.

# ASU CreateAI project service token (server-side only, never exposed to the browser).
# CREATEAI_ACCESS_TOKEN is accepted as an alias.
CREATEAI_API_KEY=
CREATEAI_QUERY_URL=https://api-main.aiml.asu.edu/query
# Deep tasks (panel building, verdict and huddle) use this model.
CREATEAI_MODEL_PROVIDER=openai
CREATEAI_MODEL_NAME=gpt4o
# Interview-loop tasks (resume audit, questions, scoring, coach hints) need speed.
# "project-default" uses the model configured on your CreateAI project.
CREATEAI_FAST_MODEL_NAME=project-default
CREATEAI_TTS_MODEL=tts1

# Session database. Defaults to a local SQLite file at ./data/panelprep.db.
# For Vercel, point this at a hosted libSQL database (e.g. Turso) so sessions persist.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Set to 1 to record every AI response of a live session to data/recordings/<session>.json,
# which can replace the hand-written demo script in lib/server/demo/maya.ts.
RECORD_FIXTURES=
